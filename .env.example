# OverNetting Bot - Environment Variables
# Скопируй в .env и заполни значениями

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Канал для проверки подписки: username или числовой chat_id
CHANNEL_ID=@ShkoloDrive

# Инвайт-ссылка на канал
CHANNEL_INVITE=https://t.me/+your_invite_code

# Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# Google Gemini API key для ShkoloDrive AI
GOOGLE_API_KEY=your_google_api_key_here

# Рабочая модель Gemini по умолчанию
AI_MODEL=models/gemini-2.5-flash

# Куда сохранять графы
GRAPH_OUTPUT_DIR=graphs

# Путь к SQLite-базе (не путать с DATABASE_URL от PostgreSQL на Railway)
DB_PATH=overnetting.db

# Публичный username канала для ссылок на посты в графах
CHANNEL_PUBLIC_USERNAME=

# Опциональные ключи для будущих интеграций
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
